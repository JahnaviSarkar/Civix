{
  "version": 2,
  "buildCommand": "cd frontend/app && npm install && npm run build",
  "outputDirectory": "frontend/app/dist",
  "functions": {
    "api/**/*.py": {
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(?<vercelpath>.*)",
      "destination": "/api/index.py?vercel_path=$vercelpath"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
